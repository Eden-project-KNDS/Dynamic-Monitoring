[Unit]
Description=Slurm GPU & CPU Resource Monitor
Documentation=https://github.com/Eden-project-KNDS/Dynamic-Monitoring
After=network.target slurmd.service

[Service]
Type=simple
LogsDirectory=slurm-monitor

# Wczytanie pliku ze zmiennymi (LISTEN_ADDRESS)
EnvironmentFile=/etc/slurm-monitor/config.env

# Przekazanie zmiennych jako argumenty pozycyjne (kolejność ma kluczowe znaczenie!)
ExecStart=/usr/local/bin/slurm-monitor ${LISTEN_ADDRESS}

DynamicUser=yes

Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=10
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
